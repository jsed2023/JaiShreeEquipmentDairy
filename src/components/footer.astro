---
const quickLinks = [
  { name: "Home", href: "/" },
  { name: "Gallery", href: "/gallery" },
  { name: "Services", href: "/services" },
  { name: "About Us", href: "/about-us" },
  { name: "Contact Us", href: "/contact-us" },
  { name: "Sitemap", href: "/sitemap.xml" },
];

const products = [
  { name: "Milk Analyzer Machines", href: "/milk-analyzer-machines" },
  {
    name: "Automatic Milk Collection System",
    href: "/automatic-milk-collection-system",
  },
  { name: "Dairy Equipment", href: "/dairy-equipment" },
  {
    name: "Milk Testing Machine Spare Parts",
    href: "/milk-testing-machine-spare-parts",
  },
  { name: "Milk Testing Equipment", href: "/milk-testing-equipment" },
];

const contact = {
  address:
    "Shop No. B-42, Upper Side, Rohit Udhyog Market, Near-HP Gas Agency, Shiv Circle Road, Sri Ganganagar, Rajasthan – 335001, India",
  phone: "+91 73750 82341",
  phoneLink: "tel:+917375082341",
  email: "choudharydairy@outlook.com",
  emailLink: "mailto:choudharydairy@outlook.com",
};

const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-cyan-900/40 bg-[#001719] text-slate-300">
  <!-- Subtle background effects -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-20 -top-20 h-40 w-40 rounded-full bg-cyan-500/5 blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-20 right-0 h-40 w-40 rounded-full bg-teal-400/5 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">

      <!-- Brand -->
      <div class="space-y-2">
        <a href="/" class="group inline-flex items-center gap-2">
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-cyan-400/30 bg-cyan-400/10 text-cyan-300 transition duration-300 group-hover:border-cyan-300 group-hover:bg-cyan-400/20"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M8 3h8l1 5H7l1-5Z" />
              <path d="M7 8v11a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V8" />
              <path d="M10 12h4" />
              <path d="M10 16h4" />
            </svg>
          </span>

          <span class="text-[20px] font-bold leading-tight tracking-tight text-white">
             <span class="text-cyan-400">Jai Shree Equipment Dairy</span>
          </span>
        </a>

        <p class="max-w-sm text-[13.5px] leading-[1.4] text-slate-400">
          Your trusted partner for milk analyzer machines, dairy equipment,
          automatic milk collection systems and professional dairy solutions.
          Serving dairy farmers and milk collection centers with quality
          products and reliable support.
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-1.5">
          <a
            href="https://www.facebook.com/Jaishreeequipmentdairy"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Jai Shree Equipment Dairy on Facebook"
            class="flex h-7 w-7 items-center justify-center rounded-md border border-cyan-900/60 bg-[#002629] text-cyan-300 transition duration-300 hover:-translate-y-0.5 hover:border-cyan-400 hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.8v8h3.4Z" />
            </svg>
          </a>

          <a
            href="https://www.youtube.com/@Jaishreeequipmentdairy"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Jai Shree Equipment Dairy on YouTube"
            class="flex h-7 w-7 items-center justify-center rounded-md border border-cyan-900/60 bg-[#002629] text-cyan-300 transition duration-300 hover:-translate-y-0.5 hover:border-cyan-400 hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-2 text-[18px] font-semibold leading-tight text-white">
          Quick Links
          <span class="mt-1 block h-0.5 w-8 rounded-full bg-cyan-400"></span>
        </h3>

        <ul class="space-y-1">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group inline-flex items-center gap-2 text-[13.5px] leading-[1.4] text-slate-400 transition-colors duration-300 hover:text-cyan-300"
              >
                <span class="h-1 w-1 rounded-full bg-cyan-500/70 transition-all duration-300 group-hover:h-1.5 group-hover:w-1.5"></span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Products -->
      <div>
        <h3 class="mb-2 text-[18px] font-semibold leading-tight text-white">
          Our Products
          <span class="mt-1 block h-0.5 w-8 rounded-full bg-cyan-400"></span>
        </h3>

        <ul class="space-y-1">
          {products.map((product) => (
            <li>
              <a
                href={product.href}
                class="group inline-flex items-start gap-2 text-[13.5px] leading-[1.4] text-slate-400 transition-colors duration-300 hover:text-cyan-300"
              >
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-cyan-500/70 transition-all duration-300 group-hover:h-1.5 group-hover:w-1.5"></span>
                {product.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Information -->
      <div>
        <h3 class="mb-2 text-[18px] font-semibold leading-tight text-white">
          Contact Information
          <span class="mt-1 block h-0.5 w-8 rounded-full bg-cyan-400"></span>
        </h3>

        <ul class="space-y-2 text-[13.5px] leading-[1.4] text-slate-400">
          <!-- Address -->
          <li class="flex items-start gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-cyan-400"
              aria-hidden="true"
            >
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            <span>{contact.address}</span>
          </li>

          <!-- Phone -->
          <li class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-cyan-400"
              aria-hidden="true"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
            </svg>
            <a
              href={contact.phoneLink}
              class="transition-colors duration-300 hover:text-cyan-300"
            >
              {contact.phone}
            </a>
          </li>

          <!-- Email -->
          <li class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-cyan-400"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <a
              href={contact.emailLink}
              class="break-all transition-colors duration-300 hover:text-cyan-300"
            >
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-4 border-t border-cyan-900/40 pt-3 text-center">
      <p class="text-[13.5px] leading-5 text-slate-400">
        © {currentYear}
        <span class="font-semibold text-cyan-300">Jai Shree Equipment Dairy</span>.
        All Rights Reserved.
      </p>

      <p class="mt-1 text-[13.5px] leading-5 text-slate-500">
        Trusted Dairy Equipment &amp; Milk Analyzer Supplier in Rajasthan, India.
      </p>
    </div>
  </div>

  <!-- Developer Credit -->
  <div class="relative border-t border-cyan-900/40 bg-[#001214] px-4 py-1.5 text-center">
    <p class="text-[13.5px] leading-5 text-slate-400">
      Designed &amp; Developed by
      <a
        href="https://developerchoudhary.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-cyan-400 transition-colors duration-300 hover:text-cyan-200"
      >
        Developer Choudhary
      </a>
    </p>
  </div>
</footer>