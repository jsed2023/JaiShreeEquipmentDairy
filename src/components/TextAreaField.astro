
---
interface Props {
  label?: string;
  placeholder?: string;
  name?: string;
  rows?: number;
}

const {
  label = "Description",
  placeholder = "Enter your description",
  name = "description",
  rows = 4,
} = Astro.props;
---

<div class="w-full max-w-xs space-y-2">
  <label
    for={name}
    class="block text-sm font-medium text-gray-900 dark:text-white"
  >
    {label}
  </label>

  <textarea
    id={name}
    name={name}
    placeholder={placeholder}
    rows={rows}
    class="w-full resize-y rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-200 dark:border-gray-600 dark:bg-[#27272a] dark:text-white dark:placeholder-gray-400"
  ></textarea>
</div>
