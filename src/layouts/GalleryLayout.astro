
---
import MainLayout from "@/layouts/MainLayout.astro";
import { metaKeywords, siteConfig } from "@/config/site";

const title = "Dairy Equipment Gallery";

const description =
  "Explore the gallery of Jai Shree Equipment Dairy showcasing dairy equipment, installation work, machinery setup, and service activities in Sri Ganganagar, Rajasthan.";

const keywordData = metaKeywords[8];

const keywords = Array.isArray(keywordData.keywords)
  ? keywordData.keywords.join(", ")
  : keywordData.keywords;

const author = Array.isArray(keywordData.name)
  ? keywordData.name[8]
  : keywordData.name;

const baseUrl = siteConfig.url.replace(/\/$/, "");
const canonical = `${baseUrl}/gallery`;

const openGraphDescription =
  "View photos of dairy equipment installations, machinery, and services by Jai Shree Equipment Dairy.";

const twitterDescription =
  "Gallery of dairy equipment installations and machinery services by Jai Shree Equipment Dairy.";
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  author={author}
  ogTitle={title}
  ogDescription={openGraphDescription}
>
  <meta slot="head" property="og:url" content={canonical} />
  <meta slot="head" property="og:site_name" content={siteConfig.name} />
  <meta slot="head" property="og:locale" content="en_IN" />
  <meta slot="head" property="og:type" content="website" />

  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={title} />
  <meta slot="head" name="twitter:description" content={twitterDescription} />

  <meta
    slot="head"
    name="robots"
    content="index, follow, max-image-preview:large"
  />

  <div class="w-full overflow-x-hidden">
    <slot />
  </div>
</MainLayout>
