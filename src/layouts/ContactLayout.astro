---
import MainLayout from "@/layouts/MainLayout.astro";
import { metaKeywords, siteConfig } from "@/config/site";

const title = "Contact Jai Shree Equipment Dairy";

const description =
  "Reach out to Jai Shree Equipment Dairy for milk analyzers, DPU milk collection units, milking machines and dairy equipment in Sri Ganganagar, Bikaner, Hanumangarh and Anupgarh. Call or WhatsApp for price and service support.";

const keywordData = metaKeywords[5];

const keywords = Array.isArray(keywordData.keywords)
  ? keywordData.keywords.join(", ")
  : keywordData.keywords;

const author = Array.isArray(keywordData.name)
  ? keywordData.name[5]
  : keywordData.name;

const baseUrl = siteConfig.url.replace(/\/$/, "");
const canonical = `${baseUrl}/contact-us`;

const openGraphDescription =
  "Contact for milk analyzer, DPU and dairy equipment sales & service across Rajasthan.";
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  author={author}
  ogTitle={title}
  ogDescription={openGraphDescription}
>
  <meta slot="head" property="og:url" content={canonical} />
  <meta slot="head" property="og:site_name" content={siteConfig.name} />
  <meta slot="head" property="og:locale" content="en_IN" />
  <meta slot="head" property="og:type" content="website" />

  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={title} />
  <meta slot="head" name="twitter:description" content={openGraphDescription} />

  <div class="w-full overflow-x-hidden">
    <slot />
  </div>
</MainLayout>
