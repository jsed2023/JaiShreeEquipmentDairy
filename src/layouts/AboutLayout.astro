---
import MainLayout from "@/layouts/MainLayout.astro";
import { metaKeywords, siteConfig } from "@/config/site";

const title = "About";

const description =
  "Founded with a commitment to innovation and quality, Jai Shree Equipment Dairy is a trusted supplier of dairy equipment across Rajasthan, delivering reliable, efficient, and durable solutions for dairy farms and milk collection centers.";

const keywordData = metaKeywords[7];

const keywords = Array.isArray(keywordData.keywords)
  ? keywordData.keywords.join(", ")
  : keywordData.keywords;

const author = Array.isArray(keywordData.name)
  ? keywordData.name[7]
  : keywordData.name;

const openGraphDescription =
  "Learn about the journey, mission, and expertise of Jai Shree Equipment Dairy in providing high-quality dairy equipment solutions.";

const twitterDescription =
  "Discover the story and mission behind Jai Shree Equipment Dairy and its commitment to the dairy industry.";

const baseUrl = siteConfig.url.replace(/\/$/, "");
const pageUrl = `${baseUrl}/about-us`;
---

<MainLayout
  title={title}
  description={description}
  canonical={pageUrl}
  keywords={keywords}
  author={author}
  ogTitle={title}
  ogDescription={openGraphDescription}
>
  <meta slot="head" property="og:site_name" content={siteConfig.name} />
  <meta slot="head" property="og:locale" content="en_IN" />
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:url" content={pageUrl} />

  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={title} />
  <meta slot="head" name="twitter:description" content={twitterDescription} />

  <div class="w-full overflow-x-hidden">
    <slot />
  </div>
</MainLayout>
