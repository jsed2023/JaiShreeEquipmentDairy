
---
import MainLayout from "@/layouts/MainLayout.astro";
import { metaKeywords, siteConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Milk Testing Equipment",
  description = "Explore Advance Milk Analyzer Max, Advance Milk Analyzer Plus, Advance Milk Analyzer Ultra, Advance Milk Analyzer Pro 20, Ekomilk Ultra, Lactoscan Milk Analyzer, All-in-One Milk Analyzer, and Digital Ultrasonic Milk Stirrer. Find reliable milk testing equipment for accurate FAT, SNF, protein, density, and milk quality testing from Jai Shree Equipment Dairy across India.",
} = Astro.props;

const pageUrl = `${siteConfig.url}/milk-testing-equipment`;

const fullTitle = `${title} - Jai Shree Equipment Dairy`;

const ogDescription =
  "High-quality milk testing machines and analyzers for accurate dairy quality testing supplied by Jai Shree Equipment Dairy.";

const image =
  `${siteConfig.url}/images/milk-testing-equipment.webp`;
---

<MainLayout
  title={fullTitle}
  description={description}
  canonical={pageUrl}
  keywords={metaKeywords[3].keywords}
  author={metaKeywords[3].name}
  ogTitle={fullTitle}
  ogDescription={ogDescription}
  ogImage={image}
>
  <slot />
</MainLayout>
