
---
import MainLayout from "@/layouts/MainLayout.astro";
import { metaKeywords, siteConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Milk Analyzer Machines",
  description = "Looking for the best milk analyzer in India? Explore Advance Milk Analyzer Machines, Lactoscan Milk Analyzers, Ekomilk Ultra And Pro, Milk Fat Testing Machines, and FAT & SNF Testing Equipment from Jai Shree Equipment Dairy. Get reliable milk testing solutions for dairy farms, milk collection centers, laboratories, and dairy processing units across India.",
} = Astro.props;

const pageUrl = `${siteConfig.url}/milk-analyzer-machines`;

const author = metaKeywords[13].name;
const keywords = metaKeywords[13].keywords;

const ogTitle = "Milk Analyzer Machines | Jai Shree Equipment Dairy";

const ogDescription =
  "High-quality milk testing machines and analyzers for accurate dairy quality testing supplied by Jai Shree Equipment Dairy.";
---

<MainLayout
  title={`${title} - ${siteConfig.name}`}
  description={description}
  canonical={pageUrl}
  keywords={keywords}
  author={author}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={`${siteConfig.url}/og-image.jpg`}
>
  <div class="overflow-x-hidden">
    <slot />
  </div>
</MainLayout>
