---
import MilkAnalyzerMachinesLayout from "@/layouts/MilkAnalyzerMachinesLayout.astro";

import { Image } from "@/components/Image";
import { MilkAnalyzerMachines } from "@/config/products";
import { cld } from "@/utils/cloudinary";

import MilkAnalyzerMachinesShowcase from "@/components/MilkAnlayzerMachinesShowcase";
---

<MilkAnalyzerMachinesLayout>
  <div>
    <div
      id="milk-analyzer-machines"
      class="mt-4 mb-10 flex flex-col gap-y-8 sm:mt-10"
    >
      <!-- HERO -->
      <section>
        <div class="bg-sky-100 py-4xl text-sky-900 dark:bg-sky-900 dark:text-sky-100">
          <h1
            class="animate-title-gradient bg-clip-text text-center text-lg font-bold text-transparent underline sm:text-4xl"
          >
            Milk Analyzer Machines
          </h1>
        </div>

        <div class="my-5 flex justify-center">
          <Image
            src={cld("Milk_Analyzer_Machines_Dairy_Testing_Solutions.webp", {
              width: 1000,
              height: 400,
              crop: "fit",
              quality: "auto:eco",
              format: "auto",
              dpr: "auto",
            })}
            alt="Milk Analyzer Machines Dairy Testing Solutions"
            width={1000}
            height={400}
            loading="lazy"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1000px"
            className="max-w-full object-contain"
          />
        </div>
      </section>

      <!-- BEST MILK ANALYZER TITLE -->
      <div class="bg-sky-100 py-4xl text-sky-900 dark:bg-sky-900 dark:text-sky-100">
        <h2
          class="animate-title-gradient bg-clip-text text-center text-lg font-bold text-transparent underline sm:text-4xl"
        >
          Best Milk Analyzer In India
        </h2>
      </div>

      <!-- INTRODUCTION -->
      <section class="flex flex-col gap-y-4 rounded-md bg-[rgb(244,244,245)] px-4 py-8 dark:bg-[#27272a] sm:px-8">
        <p class="text-stone-700 dark:text-gray-400">
          <b>Jai Shree Equipment Dairy</b> in Sri Ganganagar offers a wide
          range of advanced <b>Milk Analyzer Machines</b> and dairy testing
          equipment designed for dairy farms, milk collection centers, and
          dairy processing units. Our modern machines provide accurate and
          reliable milk quality analysis, including fat testing, SNF
          measurement, density testing, protein analysis, and adulteration
          detection to help maintain high-quality dairy standards.

          We supply high-performance milk analyzer machines with user-friendly
          interfaces, fast testing capabilities, and durable construction for
          daily industrial and commercial use. Whether you require an
          <b>Advance Milk Analyzer</b>, <b>Ekomilk Ultra Analyzer</b>, or
          complete milk testing solutions, we provide trusted products with
          sales, service, repair, calibration, and genuine spare parts
          support.

          With a strong commitment to quality, accuracy, and customer
          satisfaction, <b>Jai Shree Equipment Dairy</b> is your trusted
          supplier for milk analyzer machines and dairy equipment in
          Rajasthan and across India.
        </p>
      </section>

      <!-- SHOWCASE -->
      <MilkAnalyzerMachinesShowcase  client:visible />

      <!-- PRODUCTS TITLE -->
      <section>
        <div
          class="mt-4 max-h-100 space-y-3 rounded-lg border border-stone-200 bg-white p-4 text-sm text-stone-600 shadow-sm backdrop-blur dark:border-zinc-700 dark:bg-zinc-900/80 dark:text-white/90 dark:shadow-lg sm:text-base"
        >
          <h2
            class="animate-title-gradient bg-clip-text text-center text-lg font-bold text-transparent underline sm:text-2xl"
          >
            Our Milk Analyzer Machines
          </h2>
        </div>
      </section>

      <!-- DESCRIPTION -->
      <section class="flex flex-col gap-y-4 rounded-xl bg-[rgb(244,244,245)] px-4 py-8 dark:bg-[#27272a] sm:px-8">
        <div class="flex flex-col gap-4 leading-8 text-stone-700 dark:text-gray-400">
          <p>
            <b>Jai Shree Equipment Dairy</b> offers a complete range of
            <b>Milk Analyzer Machines</b> designed for dairy farms, milk
            collection centers, dairy cooperatives, and milk processing
            plants. Our advanced analyzers provide fast, accurate, and
            reliable testing for milk quality, helping maintain the highest
            industry standards.
          </p>

          <p>
            Our machines accurately measure
            <b>
              Fat, SNF, Protein, Density (CLR), Added Water, Lactose, and
              Temperature
            </b>
            within seconds. Featuring user-friendly operation, high precision,
            and durable construction, they are ideal for daily commercial use
            and continuous dairy operations.
          </p>

          <p>
            Jai Shree Equipment Dairy supplies premium Milk Analyzer Machines
            along with installation, calibration, repair, spare parts, and
            after-sales support across
            <b>
              Sri Ganganagar, Hanumangarh, Bikaner, Anupgarh, Suratgarh,
              Raisinghnagar, Padampur
            </b>
            , and nearby regions. We are committed to delivering reliable
            dairy testing solutions that improve quality control and
            operational efficiency.
          </p>
        </div>
      </section>

      <!-- PRODUCT CARDS -->
      <section class="py-6">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {MilkAnalyzerMachines.map((product) => (
            <a
              href={`/milk-analyzer-machines/${product.url}`}
              class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl dark:border-zinc-700 dark:bg-zinc-900"
              aria-label={`View ${product.name} details`}
            >
              <!-- PRODUCT IMAGE -->
              <div class="flex h-72 w-full items-center justify-center overflow-hidden bg-gray-100 p-6 dark:bg-zinc-800">
                <Image
                  src={cld(product.images[0].src, {
                    width: 500,
                    height: 500,
                    crop: "fit",
                    quality: "auto:eco",
                    format: "auto",
                    dpr: "auto",
                  })}
                  alt={product.name}
                  width={500}
                  height={500}
                  loading="lazy"
                  sizes="(max-width: 640px) 220px, 260px"
                  className="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-110"
                />
              </div>

              <!-- PRODUCT INFORMATION -->
              <div class="p-5">
                <h3
                  class="line-clamp-2 animate-title-gradient bg-clip-text text-center text-xl font-bold text-transparent"
                >
                  {product.name}
                </h3>

                <p class="mt-3 line-clamp-3 text-sm text-zinc-600 dark:text-zinc-400">
                  {product.smallDesc}
                </p>

                <div class="mt-6 flex gap-3">
                  <span class="flex-1 rounded-xl bg-sky-600 py-2 text-center font-semibold text-white transition group-hover:bg-sky-700">
                    View Details
                  </span>

                  <span class="flex-1 rounded-xl border border-sky-600 py-2 text-center font-semibold text-sky-600 transition group-hover:bg-sky-600 group-hover:text-white">
                    Enquire
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MilkAnalyzerMachinesLayout>
