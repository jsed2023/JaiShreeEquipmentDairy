---
import MilestonesLayout from "@/layouts/MilestonesLayout.astro";
import { cld } from "@/utils/cloudinary";

const milestonesImage = cld("Milestones_Journey.webp");

const milestones = [
  {
    year: "2020",
    title: "Company Founded",
    desc: "Established in Sri Ganganagar with a vision to modernize dairy operations.",
    icon: "🏢",
  },
  {
     year: "2021",
    title: "Product Launch & Sales Start",
    desc: "Introduced milk analyzers, DPUs, and cream separators.",
    icon: "🚀",
  },
  {
    year: "2022",
    title: "Authorized Distributor",
    desc: "Recognized as an authorized distributor of K R Electronics Industries.",
    icon: "🤝",
  },
  {
    year: "2023",
    title: "Regional Expansion",
    desc: "Expanded sales and service network across North Rajasthan.",
    icon: "🚚",
  },
  {
    year: "2024",
    title: "Trusted Industry Partner",
    desc: "Built long-term trust through reliable products and expert service.",
    icon: "⭐",
  },
  {
    year: "2025",
    title: "Advanced Dairy Solutions",
    desc: "Introduced new technology and enhanced after-sales service support.",
    icon: "⚙️",
  },
  {
    year: "2026",
    title: "Expanding Across Rajasthan",
    desc: "Strengthening our presence with more installations and service locations.",
    icon: "📈",
  },
];

const stats = [
  { value: 6, suffix: "+", label: "Years of Experience", icon: "📅" },
  { value: 500, suffix: "+", label: "Products Installed", icon: "🛠️" },
  { value: 50, suffix: "+", label: "Spare Parts", icon: "🔩" },
  { value: 3000, suffix: "+", label: "Happy Clients", icon: "😊" },
  { value: 25, suffix: "+", label: "Service Locations", icon: "📍" },
];

const installations = [
  {
    title: "Milk Analyzer",
    description: "Milk quality testing aur accurate milk analysis ke liye modern equipment.",
    icon: "🧪",
  },
  {
    title: "Milk Collection Unit (DPU)",
    description: "Milk collection aur measurement process ko efficient banane ke liye solutions.",
    icon: "⚖️",
  },
  {
    title: "Cream Separator",
    description: "Milk se cream separation ke liye reliable dairy equipment.",
    icon: "🥛",
  },
];
---

<MilestonesLayout>
  <main class="min-h-screen overflow-hidden">

    <!-- PAGE HEADING -->
    <section class="px-4 pt-10">
      <div class="mx-auto mt-10 max-w-7xl">
        <div class="rounded-2xl border border-purple-500/20 bg-gradient-to-r from-[#120B24] via-[#1B1035] to-[#120B24] px-5 py-10 text-center shadow-xl shadow-purple-950/30 sm:px-8">
          <span class="mb-3 block text-sm font-bold uppercase tracking-[0.3em] text-purple-400">
            Our Story
          </span>

          <h1 class="bg-gradient-to-r from-purple-300 via-fuchsia-400 to-purple-300 bg-clip-text text-2xl font-extrabold text-transparent sm:text-4xl md:text-5xl">
            Jai Shree Equipment Dairy Milestones &amp; Company Journey
          </h1>

          <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-purple-200 sm:text-base">
            Discover our journey, achievements, and growth in the dairy equipment industry.
          </p>
        </div>
      </div>

      <!-- MILESTONES IMAGE -->
      <div class="my-8 flex justify-center">
        <img
          src={milestonesImage}
          alt="Jai Shree Equipment Dairy company milestones and journey"
          width="700"
          height="400"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full max-w-[700px] rounded-2xl border border-purple-500/20 object-contain shadow-xl shadow-purple-950/30"
        />
      </div>
    </section>

    <!-- JOURNEY INTRODUCTION -->
    <section class="px-4 py-12 sm:py-20">
      <div class="mx-auto max-w-5xl rounded-3xl border border-purple-500/20 bg-gradient-to-br from-[#120B24] to-[#21113D] p-6 text-center shadow-2xl shadow-purple-950/30 sm:p-12">
        <span class="block text-sm font-bold uppercase tracking-[0.3em] text-purple-400 sm:text-base">
          Our Journey
        </span>

        <h2 class="mt-4 bg-gradient-to-r from-purple-300 via-fuchsia-400 to-purple-300 bg-clip-text text-3xl font-extrabold text-transparent sm:text-4xl md:text-5xl">
          Milestones That Define Our Growth
        </h2>

        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-purple-100/80 sm:text-lg">
          From our foundation to becoming a trusted dairy equipment provider,
          every milestone reflects our commitment to quality, innovation, and service.
        </p>
      </div>
    </section>

    <!-- MILESTONE TIMELINE -->
    <section class="px-4 py-12">
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 text-center">
     <span class="text-sm font-bold uppercase tracking-[0.3em]">
  2020 — 2026
</span>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">
  Our Growth Timeline
</h2>

          <p class="mt-3 text-3xl font-extrabold sm:text-2xl">
            Har saal ek nayi achievement aur dairy industry mein aage badhne ka ek naya kadam.
          </p>
        </div>

        <div class="relative">
          <!-- Desktop timeline line -->
          <div class="absolute bottom-0 left-1/2 top-0 hidden w-1 -translate-x-1/2 rounded-full bg-gradient-to-b from-purple-400 via-fuchsia-500 to-purple-900 md:block"></div>

          <!-- Mobile timeline line -->
          <div class="absolute bottom-0 left-5 top-0 w-1 rounded-full bg-gradient-to-b from-purple-400 via-fuchsia-500 to-purple-900 md:hidden"></div>

          <div class="space-y-10 md:space-y-14">
            {milestones.map((item, index) => (
              <div class={`relative flex items-start md:items-center ${index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"}`}>

                <div class={`w-full pl-14 md:w-1/2 md:pl-0 ${index % 2 === 0 ? "md:pr-14 md:text-right" : "md:pl-14 md:text-left"}`}>
                  <article class="rounded-2xl border border-purple-500/20 bg-gradient-to-br from-[#120B24] to-[#21113D] p-6 shadow-xl shadow-purple-950/20 transition duration-300 hover:-translate-y-1 hover:border-purple-400/50">
                    <span class="inline-block rounded-full border border-purple-400/30 bg-purple-500/10 px-4 py-1 text-sm font-bold text-purple-300">
                      {item.year}
                    </span>

                    <h3 class="mt-4 text-xl font-bold text-white sm:text-2xl">
                      {item.title}
                    </h3>

                    <p class="mt-3 text-sm leading-relaxed text-purple-100/70 sm:text-base">
                      {item.desc}
                    </p>
                  </article>
                </div>

                <div class="absolute left-0 top-5 z-10 flex h-11 w-11 items-center justify-center rounded-full border-4 border-[#080512] bg-gradient-to-br from-purple-500 to-fuchsia-600 text-xl shadow-lg shadow-purple-500/30 md:left-1/2 md:top-1/2 md:-translate-x-1/2 md:-translate-y-1/2">
                  {item.icon}
                </div>

                <div class="hidden w-1/2 md:block"></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ACHIEVEMENTS -->
    <section class="px-4 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <span class="text-sm font-bold uppercase tracking-[0.3em] text-purple-400">
            Our Achievements
          </span>

          <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">
            Numbers That Reflect Our Growth
          </h2>
        </div>

        <div class="grid grid-cols-2 gap-4 lg:grid-cols-5">
          {stats.map((stat) => (
            <div class="rounded-2xl border border-purple-500/20 bg-gradient-to-br from-[#120B24] to-[#21113D] p-5 text-center shadow-xl shadow-purple-950/20 transition hover:-translate-y-1 hover:border-purple-400/50 sm:p-7">
              <div class="text-3xl">{stat.icon}</div>

              <div class="mt-4 text-3xl font-extrabold text-purple-300 sm:text-4xl">
                <span data-count={stat.value}>0</span>{stat.suffix}
              </div>

              <p class="mt-2 text-xs font-medium text-purple-100/70 sm:text-sm">
                {stat.label}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRODUCT INSTALLATIONS -->
    <section class="px-4 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <span class="text-sm font-bold uppercase tracking-[0.3em] text-purple-400">
            Our Work
          </span>

          <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">
            Our Product Installations
          </h2>

          <p class="mx-auto mt-4 max-w-2xl text-purple-100/70">
            Dairy businesses ko efficient aur modern banane ke liye hamare equipment solutions.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {installations.map((item) => (
            <article class="rounded-2xl border border-purple-500/20 bg-gradient-to-br from-[#120B24] to-[#21113D] p-7 text-center shadow-xl shadow-purple-950/20 transition duration-300 hover:-translate-y-2 hover:border-purple-400/50">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-purple-400/30 bg-purple-500/10 text-3xl">
                {item.icon}
              </div>

              <h3 class="mt-6 text-xl font-bold text-white">
                {item.title}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-purple-100/70">
                {item.description}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 pb-20 pt-8">
      <div class="mx-auto max-w-5xl rounded-3xl border border-purple-500/30 bg-gradient-to-r from-[#21113D] via-[#35145A] to-[#21113D] px-6 py-12 text-center shadow-2xl shadow-purple-950/40 sm:px-12">
        <h2 class="text-3xl font-extrabold text-white sm:text-4xl">
          Be a Part of Our Journey
        </h2>

        <p class="mx-auto mt-4 max-w-2xl text-purple-100/80">
          Apne dairy business ke liye reliable equipment aur professional support paane ke liye humse sampark karein.
        </p>

        
      </div>
    </section>

  </main>
</MilestonesLayout>

<script>
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const element = entry.target as HTMLElement;
        const target = Number(element.dataset.count);

        if (!Number.isFinite(target)) return;

        const duration = 1500;
        const startTime = performance.now();

        const animate = (currentTime: number) => {
          const progress = Math.min((currentTime - startTime) / duration, 1);
          const easedProgress = 1 - Math.pow(1 - progress, 3);

          element.textContent = Math.floor(target * easedProgress).toLocaleString("en-IN");

          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            element.textContent = target.toLocaleString("en-IN");
          }
        };

        requestAnimationFrame(animate);
        observer.unobserve(element);
      });
    },
    { threshold: 0.4 }
  );

  counters.forEach((counter) => observer.observe(counter));
</script>
