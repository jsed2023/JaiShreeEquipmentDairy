---
import AutomaticMilkCollectionSystemLayout from "@/layouts/AutomaticMilkCollectionSystemLayout.astro";

import { automaticMilkCollectionSystem } from "@/config/products";
import FullAIUISystem from "@/components/FullAIUISystem";
import { cld } from "@/utils/cloudinary";
---

<AutomaticMilkCollectionSystemLayout>

  <div class="sm:mt-10 mt-4 flex flex-col gap-y-10 mb-10">

    <!-- HERO -->
    <section class="text-center">

      <div class="bg-sky-100 dark:bg-sky-900 text-sky-900 dark:text-sky-100 py-8 rounded-lg">

        <h1 class="font-bold sm:text-4xl text-xl">
          AMCS – Automatic Milk Collection System
        </h1>

      </div>

      <div class="flex justify-center my-6">

        <img
          src={cld("Automatic_Milk_Collection_System.jpg")}
          alt="Automatic Milk Collection System by Jai Shree Equipment Dairy"
          width="1000"
          height="300"
          fetchpriority="high"
          class="rounded-lg"
        />

      </div>

    </section>


    <!-- DESCRIPTION -->
    <section class="dark:bg-[#27272a] bg-[rgb(244,244,245)] rounded-xl sm:px-8 px-4 py-8">

      <p class="dark:text-gray-400 text-stone-700 leading-relaxed">
        Upgrade your dairy farm with the Automatic Milk Collection System
        (AMCS) from Jai Shree Equipment Dairy. Serving farmers in Sri Ganganagar,
        Bikaner, Hanumangarh, and Anupgarh, our AMCS ensures hygienic milk
        collection, accurate measurement, and reduced labor costs.
      </p>

    </section>


    <!-- FEATURES -->
    <section class="bg-[rgb(244,244,245)] dark:bg-[#27272a] p-8 rounded-xl">

      <h2 class="text-center font-bold underline sm:text-2xl text-lg mb-8">
        Automatic Milk Collection System Features
      </h2>

      <div class="grid md:grid-cols-2 gap-6">

        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition duration-300 border border-zinc-200 dark:border-zinc-700">
          <h3 class="font-bold text-lg mb-2">
            ⚡ Instant Milk Analysis
          </h3>

          <p class="text-sm text-zinc-600 dark:text-zinc-300">
            Integrates with Ultrasonic Milk Analyzers (Ekomilk Ultra,
            Advance Milk Analyzer) to test Fat, SNF, Water content and
            Density (CLR) in less than 60 seconds.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition duration-300 border border-zinc-200 dark:border-zinc-700">
          <h3 class="font-bold text-lg mb-2">
            📊 Data Processing Unit
          </h3>

          <p class="text-sm text-zinc-600 dark:text-zinc-300">
            Centralized Dairy Khata system that captures milk weight
            and quality data automatically.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition duration-300 border border-zinc-200 dark:border-zinc-700">
          <h3 class="font-bold text-lg mb-2">
            ⚖️ Electronic Weighing
          </h3>

          <p class="text-sm text-zinc-600 dark:text-zinc-300">
            Connects with digital weighing scales (60kg–200kg capacity)
            for instant milk quantity recording.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-lg hover:shadow-2xl hover:-translate-y-2 transition duration-300 border border-zinc-200 dark:border-zinc-700">
          <h3 class="font-bold text-lg mb-2">
            🖨️ Instant Slip Printing
          </h3>

          <p class="text-sm text-zinc-600 dark:text-zinc-300">
            Prints receipt instantly showing milk weight, fat %, SNF %,
            and payment details.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-lg md:col-span-2 border border-zinc-200 dark:border-zinc-700">
          <h3 class="font-bold text-lg mb-2">
            📍 Service Areas
          </h3>

          <p class="text-sm text-zinc-600 dark:text-zinc-300">
            Sri Ganganagar, Bikaner, Hanumangarh, Anupgarh,
            Raisinghnagar, Suratgarh, Padampur and Pilibanga.
          </p>
        </div>

      </div>

    </section>


    <!-- AMCS SHOWCASE -->
<FullAIUISystem client:visible />


    <!-- PRODUCTS HEADING -->
    <section>

      <div class="mt-4 text-sm sm:text-base text-stone-600 dark:text-white/90 border border-stone-200 dark:border-zinc-700 rounded-lg p-4 space-y-3 bg-white dark:bg-zinc-900/80 backdrop-blur shadow-sm dark:shadow-lg">

        <h2 class="text-center font-bold underline sm:text-2xl text-lg bg-clip-text text-transparent animate-title-gradient">
          Our AMCS Products
        </h2>

      </div>

    </section>


    <!-- PRODUCTS DESCRIPTION -->
    <section class="flex flex-col gap-y-4 dark:bg-[#27272a] bg-[rgb(244,244,245)] rounded-md sm:px-8 px-4 py-8">

      <p class="dark:text-gray-400 text-stone-700 flex flex-col gap-4 leading-8">

        <span>
          <b>Automatic Milk Collection System (AMCS)</b> by
          <b>Jai Shree Equipment Dairy</b> is an advanced solution designed
          to simplify and automate the milk collection process for dairy farms,
          milk collection centers, and dairy cooperative societies. It ensures
          fast, accurate, and transparent milk procurement while minimizing
          manual errors.
        </span>

        <span>
          Our AMCS integrates digital weighing scales, milk analyzers,
          billing software, and thermal printers into a single system.
          It instantly measures milk quantity, fat percentage, SNF, density
          (CLR), and generates detailed payment receipts, making milk
          collection faster, more reliable, and completely computerized.
        </span>

        <span>
          Jai Shree Equipment Dairy provides complete installation, training,
          maintenance, spare parts, and technical support for Automatic Milk
          Collection Systems across
          <b>
            Sri Ganganagar, Hanumangarh, Bikaner, Anupgarh, Suratgarh,
            Raisinghnagar, Padampur
          </b>
          and nearby regions. Our AMCS solutions help dairy businesses
          improve efficiency, maintain transparency, and deliver accurate
          records for every milk collection.
        </span>

      </p>

    </section>


    <!-- PRODUCT CARDS -->
    <section class="py-6">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

        {automaticMilkCollectionSystem.map((product) => (

          <a
            href={`/automatic-milk-collection-system/${product.url}`}
            class="group overflow-hidden rounded-2xl bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
          >

            <!-- Product Image -->
            <div class="flex h-72 w-full items-center justify-center overflow-hidden bg-gray-100 p-6 dark:bg-zinc-800">

              <img
                src={cld(product.images[0].src, {
                  width: 500,
                  height: 500,
                  crop: "fit",
                  quality: "auto",
                  format: "auto",
                })}
                alt={product.name}
                width="500"
                height="500"
                loading="lazy"
                sizes="(max-width: 640px) 220px, 260px"
                class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-110"
              />

            </div>


            <!-- Product Content -->
            <div class="p-5">

              <h3 class="text-xl font-bold text-center text-zinc-900 dark:text-white line-clamp-2 bg-clip-text text-transparent animate-title-gradient">
                {product.name}
              </h3>

              <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-3 line-clamp-3">
                {product.smallDesc}
              </p>

              <div class="mt-6 flex gap-3">

                <span class="flex-1 bg-sky-600 text-white text-center py-2 rounded-xl font-semibold group-hover:bg-sky-700 transition">
                  View Details
                </span>

                <span class="flex-1 border border-sky-600 text-sky-600 text-center py-2 rounded-xl font-semibold hover:bg-sky-600 hover:text-white transition">
                  Enquire
                </span>

              </div>

            </div>

          </a>

        ))}

      </div>

    </section>

  </div>

</AutomaticMilkCollectionSystemLayout>
