---
import ServicesLayout from "@/layouts/ServicesLayout.astro";
import { services } from "@/config/services";
import serviceAreas from "@/config/service-areas";
import { cld } from "@/utils/cloudinary";
import { Image } from "@/components/Image";
import {
  FaShieldAlt,
  FaTools,
  FaCheckCircle,
} from "react-icons/fa";

const serviceTypes = [
  ["Installation", "Professional setup of dairy equipment at your farm."],
  ["Maintenance", "Regular servicing to ensure optimal performance."],
  ["Repairs", "Quick and efficient repair services."],
  [
    "Milk Analyzer Repair Service",
    "Expert repair service for digital milk analyzers and milk testing machines.",
  ],
  [
    "Dairy Equipment Installation",
    "Professional installation and setup of dairy machinery at your location.",
  ],
  [
    "Dairy Machinery Maintenance",
    "Regular maintenance service to ensure smooth and accurate performance.",
  ],
];

const statistics = [
  { num: 1, label: "Year Guarantee", bar: 100 },
  { num: 100, label: "Quality %", bar: 100 },
  { num: 500, label: "Machines Installed", bar: 90 },
];
---

<ServicesLayout>
  <div id="services" class="mt-4 mb-10 flex flex-col gap-y-12 sm:mt-10">

    <!-- HERO -->

    <section id="dairy-equipment-services">
      <div class="bg-sky-100 py-4 dark:bg-sky-900">
        <h1 class="text-center text-lg font-bold underline bg-clip-text text-transparent animate-title-gradient sm:text-2xl">
          Milk Analyzer Repair & Dairy Equipment Services in Rajasthan
        </h1>
      </div>

      <div class="my-5 flex justify-center" data-reveal>
  <Image
    src={cld("/Repairs.jpg")}
    alt="Dairy equipment repair service"
    loading="lazy"
    decoding="async"
    width={800}
    height={300}
    className="max-h-full max-w-full object-contain"
  />
</div>
    </section>

    <!-- SERVICE TYPES -->

    <section
      data-reveal
      class="flex flex-col gap-y-4 rounded-md bg-[rgb(244,244,245)] p-4 dark:bg-[#27272a]"
    >
      {serviceTypes.map(([title, desc]) => (
        <div class="flex justify-between gap-4">
          <h2 class="font-bold">{title}:</h2>
          <p class="flex-1">{desc}</p>
        </div>
      ))}
    </section>

    <!-- WARRANTY & GUARANTEE -->

    <section
      data-reveal
      class="rounded-md bg-[rgb(244,244,245)] p-6 dark:bg-[#27272a]"
    >
      <h2 class="text-center text-lg font-bold underline bg-clip-text text-transparent animate-title-gradient sm:text-2xl">
        Warranty & Service Guarantee
      </h2>

      <p class="mb-10 mt-3 text-center">
        Reliable warranty protection and guaranteed service quality for all dairy machines.
      </p>

      <div class="mb-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {statistics.map((stat) => (
          <div
            class="rounded-md bg-[rgb(214,214,217)] p-4 text-center transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(56,189,248,0.6)] dark:bg-[#1a1a1c]"
          >
            <div
              class="text-3xl font-bold text-sky-600"
              data-count={stat.num}
              data-suffix={stat.label.includes("%") ? "%" : "+"}
            >
              0{stat.label.includes("%") ? "%" : "+"}
            </div>

            <p class="mb-2 mt-1 text-sm">{stat.label}</p>

            <div class="h-2 w-full rounded-full bg-gray-300 dark:bg-gray-700">
              <div
                class="h-full rounded-full bg-sky-600"
                style="width: 0%"
                data-progress={stat.bar}
              ></div>
            </div>
          </div>
        ))}
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="flex items-start gap-4 rounded-md bg-[rgb(214,214,217)] p-5 dark:bg-[#1a1a1c]">
          <FaShieldAlt className="text-3xl text-sky-600" />

          <div>
            <h3 class="mb-1 font-semibold bg-clip-text text-transparent animate-title-gradient">
              Machine Guarantee
            </h3>

            <p class="mb-2 text-sm">
              Coverage against manufacturing defects and faults.
            </p>

            <ul class="space-y-1 text-sm">
              <li class="flex items-center gap-2">
                <FaCheckCircle className="text-green-500" />
                1 Year Standard Guarantee
              </li>
            </ul>
          </div>
        </div>

        <div class="flex items-start gap-4 rounded-md bg-[rgb(214,214,217)] p-5 dark:bg-[#1a1a1c]">
          <FaTools className="text-3xl text-sky-600" />

          <div>
            <h3 class="mb-1 font-semibold bg-clip-text text-transparent animate-title-gradient">
              Service Guarantee
            </h3>

            <p class="mb-2 text-sm">
              Professional installation and repair assurance.
            </p>

            <ul class="space-y-1 text-sm">
              <li class="flex items-center gap-2">
                <FaCheckCircle className="text-green-500" />
                Verified installation quality
              </li>

              <li class="flex items-center gap-2">
                <FaCheckCircle className="text-green-500" />
                Performance checked after service
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE AREAS -->

    <section class="rounded-md bg-[rgb(244,244,245)] p-6 dark:bg-[#27272a]" data-reveal>
      <h2 class="text-center text-lg font-bold underline bg-clip-text text-transparent animate-title-gradient sm:text-2xl">
        Dairy Machine Service Areas in North Rajasthan
      </h2>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {serviceAreas.map((area) => (
          <li class="rounded-md bg-[rgb(214,214,217)] p-4 dark:bg-[#1a1a1c]">
            <h3 class="font-semibold bg-clip-text text-transparent animate-title-gradient">
              {area.name}
            </h3>

            <p class="mt-1 text-sm">{area.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- SERVICES -->

    {services.map((service) => (
      <section
        class="rounded-md bg-[rgb(244,244,245)] p-6 dark:bg-[#27272a]"
        data-reveal
      >
        <h2 class="text-center text-xl font-bold underline bg-clip-text text-transparent animate-title-gradient">
          {service.name}
        </h2>

        <div class="mt-6 flex flex-wrap justify-center gap-6">
          {service.images.map((image) => (
            <figure class="flex flex-col items-center rounded-lg bg-[rgb(214,214,217)] p-6 pb-4 dark:bg-[#1a1a1c]">
              <div class="flex aspect-4/3 w-55 items-center justify-center">
                <Image
                  src={image.url}
                  alt={image.alt}
                  loading="lazy"
                  width={400}
                  height={300}
                  className="max-h-full max-w-full object-contain"
                />
              </div>

              <figcaption class="mt-3 text-center bg-clip-text text-transparent animate-title-gradient">
                {image.figcaption}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</ServicesLayout>

<script>
  // Reveal sections when they enter the viewport.
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll("[data-reveal]").forEach((element) => {
    revealObserver.observe(element);
  });

  // Animated statistics counters.
  const countObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const element = entry.target as HTMLElement;
        const target = Number(element.dataset.count || 0);
        const suffix = element.dataset.suffix || "";
        const duration = 2000;
        const startTime = performance.now();

        const animate = (currentTime: number) => {
          const progress = Math.min(
            (currentTime - startTime) / duration,
            1
          );

          const eased = 1 - Math.pow(1 - progress, 3);
          const value = Math.floor(eased * target);

          element.textContent = `${value}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(animate);
          }
        };

        requestAnimationFrame(animate);
        countObserver.unobserve(element);
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll("[data-count]").forEach((element) => {
    countObserver.observe(element);
  });

  // Animated progress bars.
  const progressObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const element = entry.target as HTMLElement;
        element.style.width = `${element.dataset.progress || 0}%`;
        progressObserver.unobserve(element);
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll("[data-progress]").forEach((element) => {
    progressObserver.observe(element);
  });
</script>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
