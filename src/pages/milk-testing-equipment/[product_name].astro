
---
import ProductLayout from "@/layouts/ProductLayout.astro";
import ProductDetail from "@/components/products/milk-testing-equipment/ProductDetail";
import { MilkTestingEquipment } from "@/config/products";

export function getStaticPaths() {
  return MilkTestingEquipment.map((product) => ({
    params: {
      product_name: product.url,
    },
    props: {
      product,
    },
  }));
}

const { product } = Astro.props;

const description =
  product.metaDescription ||
  product.smallDesc ||
  `${product.name} - Quality milk testing equipment supplied by Jai Shree Equipment Dairy, Rajasthan.`;

const firstImage = product.images?.[0];

const ogImage =
  typeof firstImage === "string"
    ? firstImage
    : firstImage?.src || undefined;

const keywords = product.keywords || [];
---

<ProductLayout
  productName={product.name}
  description={description}
  productUrl={`/milk-testing-equipment/${product.url}`}
  keywords={keywords}
  ogImage={ogImage}
>
  <ProductDetail
    client:load
    productSlug={product.url}
  />
</ProductLayout>
